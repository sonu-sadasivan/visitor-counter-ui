yarn-debug.log*
pnpm-debug.log*
*.pid
*.seed

# Editor and OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
